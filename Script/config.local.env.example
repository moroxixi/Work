# ============================================================
# Config untuk notif_total_harian.py — copy ke config.local.env
# lalu isi value. config.local.env TIDAK di-track git (rahasia).
# ============================================================

# URL web app Apps Script setelah deploy ulang report.gs
# (action=totalHarian&token=...). Isi SETELAH deploy manual.
WEBAPP_URL=

# Token proteksi endpoint totalHarian — HARUS SAMA PERSIS dengan
# TOTAL_HARIAN_TOKEN yang ditempel di report.gs (BAGIAN A).
WEBAPP_TOKEN=

# Topic ntfy — sama dengan REPORT_NTFY_TOPIC di report.gs
NTFY_TOPIC=report-checker

# Base URL ntfy (pola dari ntfy-bridge.sh / notif-freebuff.sh)
NTFY_BASE_URL=https://ntfy.sh
